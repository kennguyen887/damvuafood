## Data source
# - json: chạy storefront không cần Medusa (dữ liệu mock cố định từ JSON)
# - medusa: dùng Medusa backend như template gốc
NEXT_PUBLIC_DATA_SOURCE=json

# (Tuỳ chọn) Medusa backend URL (chỉ cần khi NEXT_PUBLIC_DATA_SOURCE=medusa)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# (Tuỳ chọn) Medusa publishable key (chỉ cần khi NEXT_PUBLIC_DATA_SOURCE=medusa)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Your store URL, should be updated to where you are hosting your storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region ISO-2 lowercase (dùng cho middleware redirect)
NEXT_PUBLIC_DEFAULT_REGION=vn

# Your Stripe public key. See – https://docs.medusajs.com/add-plugins/stripe
NEXT_PUBLIC_STRIPE_KEY=

# Your PayPal Client ID. See – https://docs.medusajs.com/add-plugins/paypal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# MeiliSearch
NEXT_PUBLIC_FEATURE_SEARCH_ENABLED=false
# NEXT_PUBLIC_SEARCH_ENDPOINT=http://localhost:7700
# NEXT_PUBLIC_SEARCH_API_KEY=

# Your Next.js revalidation secret. See – https://nextjs.org/docs/app/building-your-application/data-fetching/fetching-caching-and-revalidating#on-demand-revalidation
REVALIDATE_SECRET=supersecret
